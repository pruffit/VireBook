{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    // Node 24 runs .ts directly by stripping types, and it wants the real
    // extension in the specifier. esbuild is fine with it too, so imports look
    // the same whether a file is bundled or run straight from source.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,

    // esbuild does the transpiling; tsc is here only to tell us we are wrong.
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
