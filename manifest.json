{
  "manifest_version": 3,
  "name": "VireBook",
  "description": "Downloads a whole book as EPUB, MOBI, FB2 or TXT in one press — assembled right in the browser, with nothing to wait for.",
  "version": "1.3.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Download book",
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://ficbook.net/*",
        "*://*.ficbook.net/*",
        "*://archiveofourown.org/*",
        "*://*.archiveofourown.org/*",
        "*://fanfics.me/*",
        "*://*.fanfics.me/*",
        "*://*.fanfiction.net/*",
        "*://*.wattpad.com/*",
        "*://*.royalroad.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
