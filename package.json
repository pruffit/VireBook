{
  "name": "virebook",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "description": "Browser extension: a whole book as EPUB/MOBI/FB2/TXT in one press",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "build:glass": "node scripts/build-glass.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.ts && node test/adapters.ts",
    "test:formats": "node test/run.ts",
    "test:adapters": "node test/adapters.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "demo": "node scripts/serve.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2"
  }
}
